# NAT64 ISP Manager - example environment file.
#
# Copy to /etc/nat64-manager/nat64-manager.env on the gateway (mode 0640,
# owner root:nat64mgr) and edit every CHANGE_ME value. The backend also reads
# .env from the repository root or backend/ during development.
#
# Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
APP_NAME=NAT64 ISP Manager
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1
TIMEZONE=UTC
LOG_LEVEL=INFO
# Leave empty to log to journald/stdout.
LOG_FILE=
ENABLE_DOCS=false
# demo_mode must stay false in production. It never generates synthetic data.
DEMO_MODE=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Production: PostgreSQL. The psycopg driver is included in requirements.txt.
DATABASE_URL=postgresql+psycopg://nat64:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/nat64
SQLITE_FALLBACK_ALLOWED=false
DATABASE_ECHO=false

# Optional Redis for shared rate limiting and caching. Not required.
REDIS_URL=
CACHE_TTL_SECONDS=5

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# Fernet key used for secrets at rest (HA VRRP secret, integration tokens).
APP_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15

# Comma-separated. Restrict this to the UI origin(s) in production.
# For the local Docker evaluation stack, use http://127.0.0.1:8080.
CORS_ORIGINS=https://nat64.example.net
# The hostnames the API accepts. Never leave "*" in production.
# For the local Docker evaluation stack, use 127.0.0.1,localhost.
TRUSTED_HOSTS=nat64.example.net
SECURE_COOKIES=false
CSRF_ENABLED=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Bootstrap administrator
# ---------------------------------------------------------------------------
# Set DEFAULT_ADMIN_PASSWORD only for the first start, then remove it from the
# environment file. After bootstrap, create named accounts and disable the
# initial account through Settings -> Users & roles.
BOOTSTRAP_ADMIN=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BOOTSTRAP_PASSWORD
DEFAULT_ADMIN_EMAIL=admin@example.invalid

# ---------------------------------------------------------------------------
# Privileged host helper
# ---------------------------------------------------------------------------
# The backend runs as the unprivileged nat64mgr user and calls the root-owned
# helper through sudo -n. Only the helper path is allowed by sudoers.
HOST_CONTROL_MODE=sudo
HOSTCTL_PATH=/opt/nat64-manager/hostctl.py
HOSTCTL_PYTHON=/usr/bin/python3
HOSTCTL_USE_SUDO=true
HOSTCTL_TIMEOUT_SECONDS=45
ALLOW_PACKAGE_INSTALL=false

# ---------------------------------------------------------------------------
# Jool 4
# ---------------------------------------------------------------------------
JOOL_BINARY=jool
DEFAULT_JOOL_INSTANCE=default
JOOL_NETNS=
JOOL_FRAMEWORK=netfilter
JOOL_MIN_VERSION=4.0.0
JOOL_COMMAND_TIMEOUT=20
JOOL_POOL4_DEFAULT_PORT_MIN=61001
JOOL_POOL4_DEFAULT_PORT_MAX=65535

# ---------------------------------------------------------------------------
# DNS64 / BIND9
# ---------------------------------------------------------------------------
DNS_MANAGED_CONFIG=/etc/bind/nat64-manager.conf
DNS_SERVICE_NAME=named
DNS_STATS_PATH=/var/cache/bind/named.stats
DNS_CHECK_BINARY=named-checkconf
DNS_CONTROL_BINARY=rndc
DNS_TEST_DOMAIN=ipv4only.arpa
DNS_DEFAULT_UPSTREAMS=1.1.1.1,8.8.8.8
DNS_LISTEN_ADDRESS=127.0.0.1
DNS_QUERY_TIMEOUT_SECONDS=4

# ---------------------------------------------------------------------------
# Network / firewall
# ---------------------------------------------------------------------------
NETWORK_MANAGED_NETPLAN=/etc/netplan/90-nat64-manager.yaml
NETWORK_MANAGED_SYSCTL=/etc/sysctl.d/90-nat64-manager.conf
NETWORK_BACKUP_DIR=/var/backups/nat64-manager
NETWORK_ROLLBACK_SECONDS=120
FIREWALL_MANAGED_FILE=/etc/nftables.d/nat64-manager.nft
FIREWALL_TABLE_NAME=nat64mgr
BACKUP_DIR=/var/lib/nat64-manager/backups

# ---------------------------------------------------------------------------
# Collector
# ---------------------------------------------------------------------------
# Leave enabled on a real gateway. Run exactly one API worker so collection is
# not duplicated. Disable only for the UI-only Docker Compose stack.
COLLECTOR_ENABLED=true
COLLECTOR_INTERVAL_SECONDS=5
SESSION_SYNC_INTERVAL_SECONDS=5
METRICS_INTERVAL_SECONDS=10
METRICS_RETENTION_DAYS=30
SESSION_RETENTION_HOURS=24
COLLECT_ALL_PROTOCOLS=true
MAX_SESSIONS_PER_SYNC=50000

# ---------------------------------------------------------------------------
# High availability (optional, experimental session continuity)
# ---------------------------------------------------------------------------
HA_ENABLED=false
HA_NODE_NAME=gateway-1
HA_ROLE=standalone
HA_SYNC_TOKEN=
HA_HEARTBEAT_SECONDS=10

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
SERVE_FRONTEND=true
FRONTEND_DIST=/opt/nat64-manager/frontend/dist
